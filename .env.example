
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_API_URL=
TELEGRAM_API_KEY=
# Отдельный Telegram-бот для уведомлений о цифровых заказах Ozon.
# Создайте бота через BotFather. Каждый получатель открывает бота и нажимает «Старт».
OZON_NOTIFIER_BOT_TOKEN=
OZON_NOTIFIER_POLL_INTERVAL_SEC=15
# Для автовыдачи ждём это число секунд, прежде чем просить вмешательство оператора.
OZON_NOTIFIER_OPERATOR_WAIT_SEC=120
# Отдельный секрет шифрования ручных пулов ключей. Не используйте токен Ozon или Яндекс Маркета.
MARKETPLACE_KEY_POOL_SECRET=
# Отдельный секрет шифрования токенов подключенных кабинетов Marketplace. Не используйте токен маркетплейса.
MARKETPLACE_CREDENTIALS_SECRET=
# Путь к корпоративному CA-файлу, если стандартное хранилище и certifi не доверяют сертификату API.
MARKETPLACE_CA_CERT_PATH=
NS_GIFT_API_URL=https://api.ns.gifts
NS_GIFT_LOGIN=
NS_GIFT_PASSWORD=
NS_GIFT_TIMEOUT_SEC=20
NS_GIFT_SSL_VERIFY=true
NS_GIFT_CA_CERT_PATH=
NS_GIFT_USER_AGENT=Mozilla/5.0 (compatible; GameSalesBot/1.0)
INTERHUB_API_URL=https://api.interhub.ae
INTERHUB_TOKEN=
INTERHUB_TIMEOUT_SEC=20
INTERHUB_SSL_VERIFY=true
INTERHUB_CA_CERT_PATH=
# Адрес HTTP CONNECT-proxy только для InterHub; локально: http://127.0.0.1:3128.
INTERHUB_PROXY_URL=
# Параметры команды VS Code «InterHub Tunnel». Укажите SSH-алиас или user@host сервера с whitelisted IP.
INTERHUB_TUNNEL_HOST=
INTERHUB_TUNNEL_LOCAL_PORT=3128
INTERHUB_TUNNEL_REMOTE_PORT=3128
INTERHUB_CALCULATE_PATH=/api/agent/payment/check/calculate
INTERHUB_CHECK_PATH=/api/agent/payment/check
INTERHUB_PAY_PATH=/api/agent/payment/pay
INTERHUB_CHECK_STATUS_PATH=/api/agent/payment/check_status
INTERHUB_DEPOSIT_PATH=/api/agent/deposit
# Пауза между calculate при ручном обновлении прайс-кэша, чтобы не создавать всплеск запросов.
INTERHUB_PRICE_CALCULATE_DELAY_MS=700
# Частота проверки новых цифровых заказов Ozon и ответов Interhub на сервере, в секундах.
OZON_SUPPLIER_POLL_INTERVAL_SEC=60
# Разрешает внешние действия Ozon. В staging без отдельного кабинета используйте false.
OZON_LIVE_ENABLED=true
# После этого числа проверок неопределенная оплата требует ручной сверки без запуска новой покупки.
OZON_SUPPLIER_MAX_STATUS_CHECKS=30
# Не продолжаем автопроверку в последние минуты перед дедлайном выдачи Ozon.
OZON_SUPPLIER_DEADLINE_BUFFER_SEC=600
ACCOUNTS_IMPORT_LIMIT_PER_SHEET=
YANDEX_MARKET_TOKEN=
YANDEX_MARKET_BUSINESS_ID=
YANDEX_MARKET_CAMPAIGN_ID=
YANDEX_MARKET_SOURCE_CODE=ym
YANDEX_MARKET_SOURCE_NAME=ASAT
YANDEX_MARKET_ASAT_TOKEN=
YANDEX_MARKET_ASAT_BUSINESS_ID=
YANDEX_MARKET_ASAT_CAMPAIGN_ID=
YANDEX_MARKET_ASAT_SOURCE_CODE=ym
YANDEX_MARKET_ASAT_SOURCE_NAME=ASAT
# Отдельный пустой магазин Маркета для безопасной отладки тестовых заказов.
# Токен добавляется только в локальный/staging env и никогда не коммитится.
YANDEX_MARKET_TEST_TOKEN=
YANDEX_MARKET_TEST_BUSINESS_ID=216926720
YANDEX_MARKET_TEST_CAMPAIGN_ID=149196813
YANDEX_MARKET_TEST_SOURCE_CODE=ym
YANDEX_MARKET_TEST_SOURCE_NAME=Yandex test
# Включает чтение заказов с fake=true только из магазина TEST.
YANDEX_MARKET_TEST_INCLUDE_FAKE_ORDERS=true
# Любые действия с тестовыми заказами должны включаться отдельно позднее.
YANDEX_MARKET_TEST_SANDBOX_ACTIONS_ENABLED=false
# Внешняя передача цифрового ключа в test-кабинет Маркета включается отдельным флагом.
YANDEX_MARKET_TEST_SANDBOX_MARKET_DELIVERY_ENABLED=false
# Боевой автоконтур цифровых товаров Яндекс Маркета. Оба значения должны быть заданы явно.
# Пока AUTO_DELIVERY_ENABLED=false, уведомления и ручная синхронизация не могут выдать ключ или вызвать Interhub.
YANDEX_MARKET_ASAT_AUTO_DELIVERY_ENABLED=false
# После включения автоматики обрабатываются только уведомления, принятые не раньше этой UTC-даты.
YANDEX_MARKET_ASAT_AUTO_DELIVERY_NOT_BEFORE=
# Проверка уже начатых платежей Interhub. Новый заказ и повторный pay этим циклом не запускаются.
YANDEX_MARKET_SUPPLIER_POLL_INTERVAL_SEC=60
# Небольшая пауза после принятия цифрового кода перед повторной публикацией сохраненного остатка.
MARKETPLACE_STOCK_REPUBLISH_DELAY_SEC=3
# Какой магазин показывает собранный frontend: test для staging, asat для production.
VITE_YANDEX_MARKET_STORE_CODE=test
YANDEX_MARKET_SPS_TOKEN=
YANDEX_MARKET_SPS_BUSINESS_ID=
YANDEX_MARKET_SPS_CAMPAIGN_ID=
YANDEX_MARKET_SPS_SOURCE_CODE=ym
YANDEX_MARKET_SPS_SOURCE_NAME=SPS
YANDEX_MARKET_MDS_TOKEN=
YANDEX_MARKET_MDS_BUSINESS_ID=
YANDEX_MARKET_MDS_CAMPAIGN_ID=
YANDEX_MARKET_MDS_SOURCE_CODE=ym
YANDEX_MARKET_MDS_SOURCE_NAME=MDS
YANDEX_MARKET_PROJECT_CODE=marketplace
YANDEX_MARKET_REVENUE_OPERATION_CODE=revenue_marketplace_api
YANDEX_MARKET_COMMISSION_OPERATION_CODE=direct_marketplace_commission_api
YANDEX_MARKET_GENERATE_COOLDOWN_SEC=125
YANDEX_MARKET_REPORT_ATTEMPTS=30
YANDEX_MARKET_REPORT_SLEEP_SEC=10
YANDEX_MARKET_SSL_VERIFY=true
YANDEX_MARKET_CA_CERT_PATH=
# Временно выключает только каталог, архив и остатки Маркета, не затрагивая финансовую синхронизацию.
YANDEX_MARKET_CATALOG_LIVE_ENABLED=true
YANDEX_MARKET_CATALOG_MAX_PAGES=1000
# Параметры ответа на PING для подключения API-уведомлений в кабинете Маркета.
YANDEX_MARKET_WEBHOOK_INTEGRATION_NAME=GameSales
YANDEX_MARKET_WEBHOOK_INTEGRATION_VERSION=1.0.0
