{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Frontend Dev",
      "type": "shell",
      "command": "set -a && source ${workspaceFolder}/.env.dev && set +a && npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/gamesales-web",
        "shell": {
          "executable": "/bin/zsh",
          "args": [
            "-lc"
          ]
        }
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Backend Dev",
      "type": "shell",
      "command": "source ${workspaceFolder}/.venv/bin/activate && uvicorn app:app --reload --host 0.0.0.0 --port 8000",
      "options": {
        "cwd": "${workspaceFolder}/api",
        "shell": {
          "executable": "/bin/zsh",
          "args": [
            "-lc"
          ]
        }
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "InterHub Tunnel",
      "type": "shell",
      "command": "source ${workspaceFolder}/.venv/bin/activate && python api/scripts/run_interhub_tunnel.py",
      "options": {
        "cwd": "${workspaceFolder}",
        "shell": {
          "executable": "/bin/zsh",
          "args": [
            "-lc"
          ]
        }
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Staging DB SSH Tunnel",
      "type": "shell",
      "command": "ssh -N -o ExitOnForwardFailure=yes -o ServerAliveInterval=30 -o ServerAliveCountMax=3 -L 127.0.0.1:5433:127.0.0.1:5433 adminops@138.16.162.73",
      "options": {
        "cwd": "${workspaceFolder}",
        "shell": {
          "executable": "/bin/zsh",
          "args": [
            "-lc"
          ]
        }
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Run Frontend + Backend",
      "dependsOn": [
        "Backend Dev",
        "Frontend Dev",
        "Staging DB SSH Tunnel"
      ],
      "dependsOrder": "parallel",
      "problemMatcher": []
    },
    {
      "label": "Run Frontend + Backend + InterHub Tunnel",
      "dependsOn": [
        "Backend Dev",
        "Frontend Dev",
        "Staging DB SSH Tunnel",
        "InterHub Tunnel"
      ],
      "dependsOrder": "parallel",
      "problemMatcher": []
    },
    {
      "label": "Backend UI (no workers)",
      "type": "shell",
      "command": "GAMESALES_LOCAL_UI=1 ${workspaceFolder}/.venv/bin/uvicorn app:app --reload --host 127.0.0.1 --port 8000",
      "options": {
        "cwd": "${workspaceFolder}/api",
        "shell": {
          "executable": "/bin/zsh",
          "args": [
            "-lc"
          ]
        }
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Frontend UI (local API)",
      "type": "shell",
      "command": "set -a && source ${workspaceFolder}/.env.dev && set +a && VITE_API_BASE=http://127.0.0.1:8000 npm run dev -- --host 127.0.0.1 --port 5173 --strictPort",
      "options": {
        "cwd": "${workspaceFolder}/gamesales-web",
        "shell": {
          "executable": "/bin/zsh",
          "args": [
            "-lc"
          ]
        }
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Local UI + InterHub (no workers)",
      "dependsOn": [
        "Staging DB SSH Tunnel",
        "InterHub Tunnel",
        "Backend UI (no workers)",
        "Frontend UI (local API)"
      ],
      "dependsOrder": "parallel",
      "problemMatcher": []
    },
    {
      "label": "Airpay Tunnel",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/python api/scripts/run_airpay_tunnel.py",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Local UI + suppliers (no workers)",
      "dependsOn": [
        "Staging DB SSH Tunnel",
        "InterHub Tunnel",
        "Airpay Tunnel",
        "Backend UI (no workers)",
        "Frontend UI (local API)"
      ],
      "dependsOrder": "parallel",
      "problemMatcher": []
    }
  ]
}
