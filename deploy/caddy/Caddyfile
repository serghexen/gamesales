# HTTPS принимается здесь, а существующий веб-контейнер продолжает обслуживать сайт и API.
www.homtech.app {
    redir https://homtech.app{uri} permanent
}

homtech.app {
    encode zstd gzip
    # Сохраняем цепочку прокси Маркета, чтобы API получил исходный IP уведомления.
    reverse_proxy web:80
}
